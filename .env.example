# Supabase — usado pela lista de espera e pelo painel /admin
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de servidor (não exponha no client). Necessária para o /admin ler os dados.
SUPABASE_SERVICE_ROLE_KEY=

# Senha do painel administrativo em /admin
ADMIN_PASSWORD=

# Data de lançamento (ISO 8601). Se vazio, mostra "LANÇAMENTO EM BREVE".
NEXT_PUBLIC_LAUNCH_DATE=
